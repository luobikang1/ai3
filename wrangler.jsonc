{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baihu-ai-three",
  "main": ".opennext/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".opennext/assets"
  },
  "observability": {
    "enabled": true
  }
}
